#!/usr/bin/env python3
"""Cross-platform userspace client for Google usb-serial-simple interfaces."""

import argparse
import os
import sys
import threading
from typing import Iterator, NamedTuple

import usb.core
import usb.util

# From drivers/usb/serial/usb-serial-simple.c (GOOGLE_IDS):
GOOGLE_VENDOR_ID = 0x18D1
USB_CLASS_VENDOR_SPEC = 0xFF
GOOGLE_SERIAL_SUBCLASS = 0x50
GOOGLE_SERIAL_PROTOCOL = 0x01


class SerialInterface(NamedTuple):
    dev: usb.core.Device
    cfg: usb.core.Configuration
    intf: usb.core.Interface
    ep_in: usb.core.Endpoint
    ep_out: usb.core.Endpoint
    product: str
    name: str


def enumerate_interfaces() -> Iterator[SerialInterface]:
    """Yields Google usb-serial-simple interfaces across 0x18d1 USB devices."""
    devices = sorted(
        usb.core.find(find_all=True, idVendor=GOOGLE_VENDOR_ID),
        key=lambda dev: (dev.bus, dev.port_numbers or (dev.address,)),
    )

    for dev in devices:
        try:
            try:
                cfg = dev.get_active_configuration()
            except usb.core.USBError:
                dev.set_configuration()
                cfg = dev.get_active_configuration()
        except usb.core.USBError:
            continue

        product_name = None
        for intf in sorted(cfg, key=lambda item: item.bInterfaceNumber):
            if (
                intf.bInterfaceClass != USB_CLASS_VENDOR_SPEC
                or intf.bInterfaceSubClass != GOOGLE_SERIAL_SUBCLASS
                or intf.bInterfaceProtocol != GOOGLE_SERIAL_PROTOCOL
            ):
                continue

            ep_in = usb.util.find_descriptor(
                intf,
                custom_match=lambda e: (
                    usb.util.endpoint_direction(e.bEndpointAddress) == usb.util.ENDPOINT_IN
                    and usb.util.endpoint_type(e.bmAttributes) == usb.util.ENDPOINT_TYPE_BULK
                ),
            )
            ep_out = usb.util.find_descriptor(
                intf,
                custom_match=lambda e: (
                    usb.util.endpoint_direction(e.bEndpointAddress) == usb.util.ENDPOINT_OUT
                    and usb.util.endpoint_type(e.bmAttributes) == usb.util.ENDPOINT_TYPE_BULK
                ),
            )
            if ep_in is None or ep_out is None:
                continue

            if product_name is None:
                product_name = ""
                if dev.iProduct:
                    try:
                        product_name = usb.util.get_string(dev, dev.iProduct) or ""
                    except (usb.core.USBError, ValueError):
                        pass

            intf_name = ""
            if intf.iInterface:
                try:
                    intf_name = usb.util.get_string(dev, intf.iInterface) or ""
                except (usb.core.USBError, ValueError):
                    pass

            yield SerialInterface(
                dev=dev,
                cfg=cfg,
                intf=intf,
                ep_in=ep_in,
                ep_out=ep_out,
                product=product_name,
                name=intf_name,
            )


def print_interface(idx: int, item: SerialInterface, file=sys.stdout) -> None:
    parts = [f"{item.dev.idVendor:04x}:{item.dev.idProduct:04x}"]
    if item.product:
        parts.append(item.product)
    if item.name:
        parts.append(item.name)
    desc = " ".join(parts)
    print(
        f"[{idx}] {desc} "
        f"(bus={item.dev.bus} addr={item.dev.address} "
        f"bInterfaceNumber={item.intf.bInterfaceNumber})",
        file=file,
    )


reader_running = True


def reader_loop(ep_in: usb.core.Endpoint) -> None:
    stdout_fd = sys.stdout.fileno()
    while reader_running:
        try:
            data = ep_in.read(ep_in.wMaxPacketSize, timeout=50)
            if data:
                os.write(stdout_fd, bytes(data))
        except usb.core.USBTimeoutError:
            continue
        except usb.core.USBError as exc:
            print(f"[USB read error: {exc}]", file=sys.stderr)
            break


def writer_loop(ep_out: usb.core.Endpoint) -> None:
    stdin_fd = sys.stdin.fileno()
    try:
        while chunk := os.read(stdin_fd, ep_out.wMaxPacketSize):
            ep_out.write(chunk)
    except KeyboardInterrupt:
        pass
    except usb.core.USBError as exc:
        print(f"[USB write error: {exc}]", file=sys.stderr)


def detach_kernel_driver(dev: usb.core.Device, intf_num: int) -> bool:
    try:
        if dev.is_kernel_driver_active(intf_num):
            dev.detach_kernel_driver(intf_num)
            return True
    except (NotImplementedError, usb.core.USBError):
        pass
    return False


def reattach_kernel_driver(dev: usb.core.Device, intf_num: int) -> None:
    try:
        dev.attach_kernel_driver(intf_num)
    except (NotImplementedError, usb.core.USBError):
        pass


def bridge_stdio(target: SerialInterface) -> None:
    global reader_running
    dev = target.dev
    intf_num = target.intf.bInterfaceNumber

    detached = detach_kernel_driver(dev, intf_num)
    usb.util.claim_interface(dev, intf_num)

    reader_running = True
    reader_thread = threading.Thread(target=reader_loop, args=(target.ep_in,))
    reader_thread.start()

    writer_loop(target.ep_out)

    reader_running = False
    reader_thread.join()
    try:
        usb.util.release_interface(dev, intf_num)
    except usb.core.USBError:
        pass
    if detached:
        reattach_kernel_driver(dev, intf_num)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Enumerate and connect to Google usb-serial-simple USB interfaces."
    )
    parser.add_argument(
        "interface",
        nargs="?",
        type=int,
        default=None,
        help="Interface index (0..N-1) to connect to. If omitted, lists interfaces.",
    )
    args = parser.parse_args()
    if args.interface is not None and args.interface < 0:
        parser.error(f"Interface index {args.interface} must be >= 0.")
    return args


def main() -> None:
    args = parse_args()

    target = None
    count = 0
    for idx, iface in enumerate(enumerate_interfaces()):
        count += 1
        if args.interface is None:
            print_interface(idx, iface, file=sys.stdout)
        elif idx == args.interface:
            target = iface
            break

    if count == 0:
        print(
            f"No matching Google serial interfaces (0xff/0x50/0x01) found for vendor {GOOGLE_VENDOR_ID:04x}.",
            file=sys.stderr,
        )
        sys.exit(1)

    if args.interface is not None:
        if target is None:
            print(
                f"Interface index {args.interface} out of range (0..{count - 1}).",
                file=sys.stderr,
            )
            sys.exit(1)

        print_interface(args.interface, target, file=sys.stderr)
        bridge_stdio(target)


if __name__ == "__main__":
    main()
