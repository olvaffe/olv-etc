#!/bin/sh

# for rescue (~700M)
cli_min="
	base
	btrfs-progs
	dosfstools
	vim
"

# for all devices including servers (~50M)
cli_base="
	$cli_min
	htop
	ldns
	less
	logrotate
	openssh
	rsync
	smartmontools
	sudo
	usbutils
"

# for workstations, vms, and duts (~250M)
cli_std="
	$cli_base
	bc
	git
	lsof
	man-db
	man-pages
	python
	strace
	tmux
	unzip
	zip
"

# for workstations (~150M)
cli_full="
	$cli_std
	jq
	nordvpn-bin
	picocom
	wireguard-tools
"

# for terminal (~450M)
gui_min="
	alacritty
	i3status
	noto-fonts
	polkit
	sway
"

# for basic use (~250M)
gui_base="
	$gui_min
	brightnessctl
	grim
	mesa-utils
	slurp
	swayidle
	swayimg
	swaylock
	vulkan-tools
	wayland-utils
	wl-clipboard
"

# for real use (~1000M)
gui_std="
	$gui_base
	fcitx5-chewing
	fcitx5-configtool
	fcitx5-gtk
	google-chrome
	mako
	noto-fonts-cjk
	noto-fonts-emoji
	pipewire-pulse
"

# for optional features (~300M)
gui_full="
	$gui_std
	cups
	mpv
	xdg-desktop-portal-gtk
	xdg-desktop-portal-wlr
"

# for tooling (~350M)
dev_min="
	ctags
	gdb
	perf
	trace-cmd
"

# for development (~750M)
dev_base="
	$dev_min
	base-devel
	ccache
	clang
	cmake
	meson
"

# for cross-compile (~600M)
dev_cross="
	aarch64-linux-gnu-gcc
	qemu-user-static
	qemu-user-static-binfmt
"

# for kernel (~50M)
# all are for cros kernel
dev_kernel="
	dtc
	vboot-minimal-git
"

# for mesa (~250M)
dev_mesa="
	glslang
	libclc
	llvm
	spirv-llvm-translator
"

kernel_min="
	zram-generator
"

kernel_x86="
	$kernel_min
	linux
"

kernel_uki="
	sbctl
	systemd-ukify
"

soc_intel="
	intel-ucode
	linux-firmware-intel
	vulkan-intel
"

soc_amd="
	amd-ucode
	linux-firmware-amdgpu
	vulkan-radeon
"

soc_mtk="
	linux-firmware-mediatek
	linux-firmware-other
	vulkan-panfrost
"

soc_qcom="
	linux-firmware-atheros
	linux-firmware-qcom
	vulkan-freedreno
"

net_mtk="
	linux-firmware-mediatek
"

net_rt="
	linux-firmware-realtek
"

net_wifi="
	iw
	wireless-regdb
	wpa_supplicant
"

net_bt="
	bluez
	bluez-utils
"

misc_x86="
	  turbostat
"

misc_alarm="
	archlinuxarm-keyring
"

misc_dut="
	seatd
"

mach_ridge="
	evemu
	pavucontrol
	steam
	xorg-xwayland
"

mach_xps="
	bcm20702a1-firmware
	broadcom-wl-dkms
	linux-headers
"

pkgs=""

host="$(uname -n)"
case "$host" in
	"ridge"|"t580"|"xps")
		pkgs="$pkgs $cli_full $gui_full"
		pkgs="$pkgs $dev_base $dev_cross $dev_kernel $dev_mesa"
		pkgs="$pkgs $kernel_x86 $kernel_uki"
		pkgs="$pkgs $net_wifi $misc_x86"

		if [ "$host" = "ridge" ]; then
			pkgs="$pkgs $soc_amd $net_mtk $net_bt $mach_ridge"
		elif [ "$host" = "t580" ]; then
			pkgs="$pkgs $soc_intel"
		elif [ "$host" = "xps" ]; then
			pkgs="$pkgs $soc_intel $mach_xps"
		fi
		;;
	"rex"|"skyrim")
		pkgs="$pkgs $cli_std $gui_base"
		pkgs="$pkgs $dev_base $dev_mesa"
		pkgs="$pkgs $kernel_min"
		pkgs="$pkgs $net_rt $misc_x86 $misc_dut"

		if [ "$host" = "rex" ]; then
			pkgs="$pkgs $soc_intel"
		elif [ "$host" = "skyrim" ]; then
			pkgs="$pkgs $soc_amd"
		fi
		;;
	"navi"|"corsola"|"trogdor")
		pkgs="$pkgs $cli_std $gui_base"
		pkgs="$pkgs $dev_base $dev_mesa"
		pkgs="$pkgs $kernel_min"
		pkgs="$pkgs $net_rt $misc_alarm $misc_dut"

		if [ "$host" = "navi" -o "$host" = "corsola" ]; then
			pkgs="$pkgs $soc_mtk"
		elif [ "$host" = "trogdor" ]; then
			pkgs="$pkgs $soc_qcom"
		fi
		;;
	"s15"|"hamoa"|"purwa"|"opi")
		pkgs="$pkgs $cli_std $gui_base"
		pkgs="$pkgs $dev_base $dev_mesa"
		pkgs="$pkgs $kernel_min"
		pkgs="$pkgs $net_rt $misc_alarm $misc_dut"

		if [ "$host" = "s15" -o "$host" = "hamoa" -o "$host" = "purwa" ]; then
			pkgs="$pkgs $kernel_uki $soc_qcom"
			if [ "$host" = "s15" ]; then
				pkgs="$pkgs $net_wifi"
			fi
		fi
		;;
	*)
		echo "unknown device: $host"
		exit 1
		;;
esac

qeq="$(pacman -Qeq)"
if [ -n "$qeq" ]; then
	pacman -Dq --asdeps $qeq
fi

#pacman -S --needed $pkgs
pacman -Dq --asexplicit $pkgs
