#!/bin/sh

# Tips for ndk
#
#  - specify both sysroot and ndk_root if pkg-config is used

ndk_api="35"

if [ $# -lt 4 ]; then
	echo "$0 <lin|cros|ndk> <x86|arm> <64|32> <sysroot> [ndk_root]"
	exit 1
fi

flavor="$1"
arch="$2"
bits="$3"
sysroot="$4"
ndk_root="$5"

init_target_vars() {
	case "$arch-$bits" in
		x86-64)
			target_lin="x86_64-linux-gnu"
			target_cros="x86_64-linux-gnu"
			target_ndk="x86_64-linux-android$ndk_api"
			rust_target_lin="x86_64-unknown-linux-gnu"
			rust_target_ndk="x86_64-linux-android"
			;;
		x86-32)
			target_lin="i686-linux-gnu"
			target_cros="i686-cros-linux-gnu"
			target_ndk="i686-linux-android$ndk_api"
			rust_target_lin="i686-unknown-linux-gnu"
			rust_target_ndk="i686-linux-android"
			;;
		arm-64)
			target_lin="aarch64-linux-gnu"
			target_cros="aarch64-cros-linux-gnu"
			target_ndk="aarch64-linux-android$ndk_api"
			rust_target_lin="aarch64-unknown-linux-gnu"
			rust_target_ndk="aarch64-linux-android"
			;;
		arm-32)
			target_lin="arm-linux-gnueabihf"
			target_cros="armv7a-cros-linux-gnueabihf"
			target_ndk="armv7a-linux-androideabi$ndk_api"
			rust_target_lin="armv7-unknown-linux-gnueabihf"
			rust_target_ndk="armv7-linux-androideabi"
			;;
		*)
			echo "unknown $arch-$bits"
			exit 1
			;;
	esac

	case "$flavor" in
		lin)
			target="$target_lin"
			rust_target="$rust_target_lin"
			;;
		cros)
			target="$target_cros"
			rust_target="$rust_target_lin"
			;;
		ndk)
			target="$target_ndk"
			rust_target="$rust_target_ndk"
			;;
		*)
			echo "unknown $flavor"
			exit 1
			;;
	esac
}

init_mach_vars() {
	case "$flavor" in
		lin|cros)
			mach_system="linux"
			;;
		ndk)
			mach_system="android"
			;;
	esac

	case "$arch-$bits" in
		x86-64)
			mach_cpu_family="x86_64"
			mach_cpu="x86_64"
			;;
		x86-32)
			mach_cpu_family="x86"
			mach_cpu="i686"
			;;
		arm-64)
			mach_cpu_family="aarch64"
			mach_cpu="aarch64"
			;;
		arm-32)
			mach_cpu_family="arm"
			mach_cpu="armv7a"
			;;
	esac
}

init_vars() {
	init_target_vars
	init_mach_vars

	llvm_config="not-exist"
	c_args=""
	cpp_link_args=""

	case "$flavor" in
		lin)
			toolchain_prefix=""

			sysroot_args="'--sysroot=' + sysroot"
			bindgen_args="'--sysroot=' + sysroot"
			;;
		cros)
			toolchain_prefix=""

			sysroot_args="'--sysroot=' + sysroot"
			bindgen_args="'--sysroot=' + sysroot"

			llvm_config="usr/lib/llvm/bin/llvm-config-host"
			;;
		ndk)
			if [ -z "$ndk_root" ]; then
				ndk_root="$sysroot"
				sysroot="/not-exist"
			fi
			toolchain_prefix="$ndk_root/toolchains/llvm/prebuilt/linux-x86_64/bin"

			sysroot_args=""
			bindgen_args="'--target=' + target, '--sysroot=' + toolchain_prefix / '../sysroot', '-isystem', sysroot / 'usr/include'"

			c_args="'-isystem', sysroot / 'usr/include'"
			cpp_link_args="'-static-libstdc++'"
			;;
	esac

	local basedirs="usr/lib usr/lib64 usr/lib/$target usr/share"
	pkgconfigdirs=""
	for b in $basedirs; do
		pkgconfigdirs="$pkgconfigdirs, sysroot / '$b/pkgconfig'"
	done
	pkgconfigdirs="${pkgconfigdirs#, }"
}

init_vars

gen_constants() {
	cat <<EOF
[constants]
target = '$target'
rust_target = '$rust_target'
toolchain_prefix = '$toolchain_prefix'
sysroot = '$sysroot'
sysroot_args = [$sysroot_args]
bindgen_args = [$bindgen_args]
EOF
}

gen_binaries_gcc() {
	cat <<EOF
[binaries]
ar = toolchain_prefix / target + '-ar'
c = ['ccache', toolchain_prefix / target + '-gcc']
cpp = ['ccache', toolchain_prefix / target + '-g++']
rust = ['rustc', '--target', rust_target]
strip = toolchain_prefix / target + '-strip'
pkg-config = '/usr/bin/pkg-config'
EOF
}

gen_binaries_llvm() {
	cat <<EOF
[binaries]
ar = toolchain_prefix / 'llvm-ar'
c = ['ccache', toolchain_prefix / 'clang', '--target=' + target]
cpp = ['ccache', toolchain_prefix / 'clang++', '--target=' + target]
rust = ['rustc', '--target', rust_target]
strip = toolchain_prefix / 'llvm-strip'
pkg-config = '/usr/bin/pkg-config'
llvm-config = sysroot / '$llvm_config'
EOF
}

gen_builtin_options() {
	cat <<EOF
[built-in options]
c_args = sysroot_args + [$c_args]
c_link_args = sysroot_args + []
cpp_args = sysroot_args + [$c_args]
cpp_link_args = sysroot_args + [$cpp_link_args]
rust_link_args = sysroot_args + []
EOF
}

gen_properties() {
	# only for PKG_CONFIG_SYSROOT_DIR and PKG_CONFIG_LIBDIR
	cat <<EOF
[properties]
sys_root = sysroot
pkg_config_libdir = [$pkgconfigdirs]
bindgen_clang_arguments = bindgen_args + []
EOF
}

gen_host_machine() {
	cat <<EOF
[host_machine]
system = '$mach_system'
cpu_family = '$mach_cpu_family'
cpu = '$mach_cpu'
endian = 'little'
EOF
}

gen_constants
echo
case "$flavor" in
	lin)
		gen_binaries_gcc
		;;
	cros|ndk)
		gen_binaries_llvm
		;;
esac
echo
gen_builtin_options
echo
gen_properties
echo
gen_host_machine
